# Keep original captures and private setup records outside this repository.
# These rules also guard against accidentally copying them into the draft.
private-evidence/
private/
pi4-setup-*.json
archer-ap-login-*.png

# Credentials and local environment files do not belong in the public build.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
known_hosts*

# Pi-hole configuration archives contain private authentication and network data.
private-backups/
*[Tt]eleporter*.zip

# Editor and operating-system files.
.DS_Store
Thumbs.db
Desktop.ini

# Personal teaching documents are kept separately from portfolio evidence.
/guides/IT-Homelab-Pi-Foundation-Visual-Guide.pdf
/guides/images/2026-10-18-privacy-before-explained.png
